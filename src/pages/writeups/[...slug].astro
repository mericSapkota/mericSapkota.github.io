---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import { formatDate, CATEGORY_COLOR } from '../../lib/format'

export async function getStaticPaths() {
  const writeups = await getCollection('writeups', ({ data }) => !data.draft)
  return writeups.map((w) => ({ params: { slug: w.id }, props: { writeup: w } }))
}

const { writeup } = Astro.props
const { Content } = await render(writeup)
---

<Base
  title={`${writeup.data.title} — 0xm3r1c`}
  description={writeup.data.excerpt}
  current="writeups"
>
  <article class="mx-auto mt-6  w-full">
    <a href="/writeups" class="font-body text-xl underline">&larr; Back to CTF log</a>
    <header class="mt-4 mb-6 border-b-[3px] border-ink pb-5">
      <span class={`font-display text-[10px] uppercase ${CATEGORY_COLOR[writeup.data.category]}`}>
        {writeup.data.category}{writeup.data.event ? ` · ${writeup.data.event}` : ''}
      </span>
      <h1 class="mt-3 mb-0 font-display text-xl leading-relaxed">{writeup.data.title}</h1>
      <p class="mt-3 mb-0 text-lg opacity-70">{formatDate(writeup.data.date)}</p>
      {
        writeup.data.tags.length > 0 && (
          <div class="mt-3 flex flex-wrap gap-2">
            {writeup.data.tags.map((tag) => (
              <span class="border-2 border-ink bg-cream px-2 py-0.5 text-sm lowercase">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </header>
    <div class="prose-pixel">
      <Content />
    </div>
  </article>
</Base>
