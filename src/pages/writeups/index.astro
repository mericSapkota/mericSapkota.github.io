---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import PostCard from '../../components/PostCard'
import { formatDate, CATEGORY_COLOR } from '../../lib/format'

const writeups = (await getCollection('writeups', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)

const categories = [...new Set(writeups.map((w) => w.data.category))]
---

<Base title="0xm3r1c — CTF Log" current="writeups">
  <section class="mt-6">
    <span class="mb-2 block font-display text-xs text-blue">QUEST LOG</span>
    <h1 class="m-0 font-display text-2xl">CTF Writeups</h1>
    <p class="mt-3 mb-4 text-xl opacity-80">
      Walkthroughs from competitions — solved and explained.
    </p>

    {
      categories.length > 0 && (
        <div class="mb-6 flex flex-wrap gap-2">
          {categories.map((cat) => (
            <span class={`font-display text-[10px] uppercase ${CATEGORY_COLOR[cat]}`}>
              {cat}
            </span>
          ))}
        </div>
      )
    }

    {
      writeups.length === 0 ? (
        <p class="text-xl opacity-70">No writeups yet — check back soon.</p>
      ) : (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {writeups.map((w) => (
            <PostCard
              href={`/writeups/${w.id}`}
              kicker={w.data.category}
              kickerColor={CATEGORY_COLOR[w.data.category]}
              title={w.data.title}
              dateLabel={formatDate(w.data.date)}
              excerpt={w.data.excerpt}
              tags={w.data.event ? [w.data.event, ...w.data.tags] : w.data.tags}
            />
          ))}
        </div>
      )
    }
  </section>
</Base>
