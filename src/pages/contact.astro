---
import Base from '../layouts/Base.astro'

// Swap these for your real handles before deploying.
const links = [
  { label: 'EMAIL', value: 'meric5sapkota@gmail.com', href: 'mailto:meric5sapkota@gmail.com', color: 'text-red' },
  { label: 'GITHUB', value: 'github.com/mericSapkota', href: 'https://github.com/mericSapkota', color: 'text-green' },
  { label: 'Discord', value:'meric0_0'}
]
---

<Base title="0xm3r1c — Contact" current="contact">
  <section class="mt-6">
    <span class="mb-2 block font-display text-xs text-red-dark">START A CHAT</span>
    <h1 class="m-0 font-display text-2xl">Get in touch</h1>
    <p class="mt-3 mb-6 text-xl opacity-80">
      Bug reports, collab ideas, or just to say hi — pick a channel.
    </p>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="flex flex-col gap-2 border-[3px] border-ink bg-cream p-5 text-ink no-underline hover:text-ink shadow-[5px_5px_0_var(--color-ink)]"
          >
            <span class={`font-display text-[10px] ${link.color}`}>{link.label}</span>
            <span class="text-lg break-words">{link.value}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
