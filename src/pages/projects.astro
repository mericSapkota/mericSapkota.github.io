---
import Base from '../layouts/Base.astro'
import ProjectCard from '../components/ProjectCard'
import { projects } from '../data/projects'

const sorted = [...projects].sort((a, b) => b.year - a.year)
---

<Base title="0xm3r1c — Projects" current="projects">
  <section class="mt-6">
    <span class="mb-2 block font-display text-xs text-green">BUILD LOG</span>
    <h1 class="m-0 font-display text-2xl">Projects</h1>
    <p class="mt-3 mb-6 text-xl opacity-80">
      Tools, apps and experiments — from weekend hacks to things people actually use.
    </p>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {sorted.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</Base>
