---
import { getCollection } from 'astro:content'
import Base from '../../layouts/Base.astro'
import PostCard from '../../components/PostCard'
import { formatDate } from '../../lib/format'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)
---

<Base title="0xm3r1c — Blog" current="blog">
  <section class="mt-6">
    <span class="mb-2 block font-display text-xs text-gold">DEV DIARY</span>
    <h1 class="m-0 font-display text-2xl">Blog</h1>
    <p class="mt-3 mb-6 text-xl opacity-80">
      Notes on security, software and everything in between.
    </p>

    {
      posts.length === 0 ? (
        <p class="text-xl opacity-70">No posts yet — check back soon.</p>
      ) : (
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {posts.map((post) => (
            <PostCard
              href={`/blog/${post.id}`}
              kicker="Post"
              kickerColor="text-gold"
              title={post.data.title}
              dateLabel={formatDate(post.data.date)}
              excerpt={post.data.excerpt}
              tags={post.data.tags}
            />
          ))}
        </div>
      )
    }
  </section>
</Base>
